#!/usr/bin/env bash
set -u

default_user="rafael"

shell_quote() {
    local value="$1"
    value=${value//\'/\'\\\'\'}
    printf "'%s'" "$value"
}

connect() {
    local user="$1"
    local host="$2"

    # detach-client replaces the tmux UI; use its terminal for SSH prompts.
    ssh -tt "$user@$host" 'tmux attach-session || tmux new-session' </dev/tty >/dev/tty 2>&1
}

connect_with_fallback() {
    local user="$1"
    local host="$2"
    local ssh_status

    connect "$user" "$host"
    ssh_status=$?
    if [ "$ssh_status" -eq 0 ]; then
        return 0
    fi

    if [ "$ssh_status" -ne 255 ]; then
        return "$ssh_status"
    fi

    printf '\nSSH connection as %s failed. Alternate username: ' "$user" >&2
    read -r user
    [ -n "$user" ] && connect "$user" "$host"
}

if [ "${1:-}" = '--connect' ]; then
    if [ "$#" -ne 3 ]; then
        printf 'usage: %s --connect USER HOST\n' "$0" >&2
        exit 2
    fi
    connect_with_fallback "$2" "$3"
    exit $?
fi

if [ "$#" -ne 0 ]; then
    printf 'usage: %s\n' "$0" >&2
    exit 2
fi

target_client=$(tmux show-environment -g TAILSCALE_TMUX_CLIENT 2>/dev/null) || {
    printf 'error: unable to identify the invoking tmux client\n' >&2
    exit 2
}
target_client="${target_client#*=}"
tmux set-environment -gu TAILSCALE_TMUX_CLIENT
for dependency in fzf python3 tailscale tmux; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        printf 'error: %s is required\n' "$dependency" >&2
        exit 1
    fi
done

status_json=$(tailscale status --json 2>/dev/null) || {
    printf 'error: unable to read Tailscale status\n' >&2
    exit 1
}

peers=$(printf '%s' "$status_json" | python3 -c '
import json
import sys

status = json.load(sys.stdin)
self_name = status.get("Self", {}).get("DNSName", "").rstrip(".")

for peer in (status.get("Peer") or {}).values():
    name = peer.get("DNSName", "").rstrip(".") or peer.get("HostName", "")
    if not name or name == self_name:
        continue
    address = next(iter(peer.get("TailscaleIPs") or []), "-")
    state = "online" if peer.get("Online", False) else "offline"
    # The first field keeps online peers at the top without changing display.
    print("{}\t{}\t{}\t{}\t{}".format(
        0 if state == "online" else 1,
        name,
        peer.get("OS", "unknown"),
        address,
        state,
    ))
') || {
    printf 'error: unable to parse Tailscale status\n' >&2
    exit 1
}

if [ -z "$peers" ]; then
    printf 'No Tailscale peers found.\n' >&2
    exit 1
fi

selected=$(printf '%s\n' "$peers" | fzf \
    --no-sort \
    --delimiter=$'\t' \
    --with-nth=2,3,4,5 \
    --header='Machine                 OS      Address          Status' \
    --layout=reverse \
    --height=100% \
    --prompt='Connect: ') || exit 0

IFS=$'\t' read -r _ host _ _ _ <<< "$selected"
[ -n "$host" ] || exit 0

connector=$(command -v tailscale-tmux)
connect_command="$(shell_quote "$connector") --connect $(shell_quote "$default_user") $(shell_quote "$host")"
tmux detach-client -t "$target_client" -E "$connect_command"
