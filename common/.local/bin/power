#!/bin/bash
choices='󰌾  lock
󰒲  suspend
󰌾  suspend_and_lock
󰂯  bluetooth
󰐥  shutdown
󰜉  reboot
󰒓  setup
󰆍  launcher'

chosen=$(printf '%s\n' "$choices" | dmenu_command --prompt="Choose what to do ?")
chosen=$(printf '%s\n' "$chosen" | sed 's/^[^[:space:]]*[[:space:]]*//')

case "$chosen" in
    lock) lock.sh;;
    suspend) systemctl suspend ;;
    suspend_and_lock) lock.sh && systemctl suspend ;;
    bluetooth) rofi-bluetooth ;;
    shutdown) ~/.local/bin/prompt "Do you want to shutdown ?" "shutdown now";;
    reboot) ~/.local/bin/prompt "Do you want to shutdown ?" "reboot";;
    setup) ~/.local/bin/prompt "Do you want to run ~/setup ?" "sh -c ~/setup";;
    launcher) fuzzel ;;
esac
