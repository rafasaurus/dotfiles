# Serial access for Arduino tools: uucp members, not every local user.
SUBSYSTEM=="tty", KERNEL=="ttyUSB[0-9]*", GROUP="uucp", MODE="0660"
SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*", GROUP="uucp", MODE="0660"
SUBSYSTEM=="tty", KERNEL=="ttyAMA[0-9]*", GROUP="uucp", MODE="0660"
# CP210x
SUBSYSTEM=="usb", ATTR{idVendor}=="10c4", ATTR{idProduct}=="ea60", MODE="0660", GROUP="uucp", TAG+="uaccess"
